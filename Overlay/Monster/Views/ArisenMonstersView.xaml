<overlay:Widget x:Class="Arisen.Overlay.Monster.Views.ArisenMonstersView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:local="clr-namespace:Arisen.Overlay.Monster.Views"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:overlay="clr-namespace:HunterPie.UI.Overlay;assembly=HunterPie.UI"
                xmlns:viewmodels="clr-namespace:Arisen.Overlay.Monster.ViewModels"
                xmlns:visibilities="clr-namespace:HunterPie.UI.Architecture.Converters.Visibilities;assembly=HunterPie.UI"
                Width="800"
                d:DataContext="{d:DesignInstance viewmodels:ArisenMonstersViewModel}"
                mc:Ignorable="d">
	<UserControl.Resources>
		<visibilities:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
	</UserControl.Resources>

	<local:ArisenMonsterView d:Visibility="Visible"
	                         DataContext="{Binding Target, Mode=OneWay}"
	                         Visibility="{Binding ., Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
</overlay:Widget>
